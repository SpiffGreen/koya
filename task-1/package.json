{
  "name": "clinic-booking-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env scripts/dev.ts",
    "start": "tsx --env-file-if-exists=.env scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "tsx --env-file-if-exists=.env scripts/check.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.8",
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
